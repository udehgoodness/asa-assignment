# Copy to .env for local development convenience, or set these as real
# environment variables in any non-local environment — sourced from a
# secrets manager, never committed to source control.

# JWT signing key. If unset, the app generates a random ephemeral key at
# startup, which is fine for local dev/tests but means tokens won't survive
# a restart and won't be valid across multiple replicas. Set a real, stable
# value here (or via your secrets manager) for anything beyond local dev.
SECRET_KEY=

DATABASE_URL=sqlite:///./vulntracker.db
NOTIFY_SERVICE_URL=http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
ACCESS_TOKEN_EXPIRE_MINUTES=30
